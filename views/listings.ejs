<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Kho Bất Động Sản</h4>
    <p class="text-muted small mb-0">Quản lý toàn bộ danh mục sản phẩm nhà đất, căn hộ và tạo bài viết AI</p>
  </div>
  <button class="btn btn-gradient-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addListingModal">
    <i class="bi bi-plus-circle me-1"></i> Thêm BĐS Mới
  </button>
</div>

<!-- Search & Filter bar -->
<div class="card shadow-sm border-0 mb-4 bg-body">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="listingSearchInput" class="form-control border-start-0" placeholder="Tìm theo tiêu đề, địa chỉ, số điện thoại..." onkeyup="filterListings()">
        </div>
      </div>
      <div class="col-md-3">
        <select id="priceFilter" class="form-select" onchange="filterListings()">
          <option value="all">Tất cả mức giá</option>
          <option value="under_3">Dưới 3 Tỷ</option>
          <option value="3_to_7">Từ 3 - 7 Tỷ</option>
          <option value="above_7">Trên 7 Tỷ</option>
        </select>
      </div>
      <div class="col-md-4 text-md-end text-muted small">
        Tổng số: <strong class="text-primary" id="totalListingsCount"><%= listings.length %></strong> bất động sản
      </div>
    </div>
  </div>
</div>

<!-- Listings Cards Grid -->
<div class="row g-4" id="listingsContainer">
  <% if (listings && listings.length > 0) { %>
    <% listings.forEach(item => { %>
      <div class="col-md-6 col-xl-4 listing-item" 
           data-title="<%= item.title.toLowerCase() %>" 
           data-address="<%= item.address.toLowerCase() %>"
           data-phone="<%= (item.contact_phone || '').toLowerCase() %>"
           data-price="<%= item.price || 0 %>">
        <div class="card h-100 shadow-sm border-0 overflow-hidden stat-card">
          <!-- Image Header -->
          <div class="position-relative" style="height: 190px; background-color: #f1f5f9;">
            <img src="<%= item.images || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=600&auto=format&fit=crop&q=80' %>" 
                 class="w-100 h-100 object-fit-cover" 
                 alt="<%= item.title %>"
                 onerror="this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=600&auto=format&fit=crop&q=80'">
            
            <div class="position-absolute top-0 end-0 m-2">
              <span class="badge bg-dark bg-opacity-75 rounded-pill px-2 py-1">
                <i class="bi bi-clock me-1"></i><%= new Date(item.created_at).toLocaleDateString('vi-VN') %>
              </span>
            </div>

            <div class="position-absolute bottom-0 start-0 m-2">
              <span class="badge bg-danger fs-6 fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                <%= item.price ? item.price + ' Tỷ' : 'Thỏa thuận' %>
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="card-body p-3 d-flex flex-column">
            <h6 class="fw-bold mb-2 text-truncate" title="<%= item.title %>"><%= item.title %></h6>
            
            <p class="small text-muted mb-2 text-truncate-2" style="font-size: 0.85rem; height: 2.4rem; overflow: hidden;">
              <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= item.address %>
            </p>

            <div class="d-flex flex-wrap gap-2 mb-3">
              <% if (item.area) { %>
                <span class="badge bg-body-secondary text-body small"><i class="bi bi-aspect-ratio me-1"></i><%= item.area %> m²</span>
              <% } %>
              <% if (item.bedrooms) { %>
                <span class="badge bg-body-secondary text-body small"><i class="fa-solid fa-bed me-1"></i><%= item.bedrooms %> PN</span>
              <% } %>
              <% if (item.bathrooms) { %>
                <span class="badge bg-body-secondary text-body small"><i class="fa-solid fa-bath me-1"></i><%= item.bathrooms %> WC</span>
              <% } %>
              <% if (item.direction) { %>
                <span class="badge bg-body-secondary text-body small"><i class="bi bi-compass me-1"></i><%= item.direction %></span>
              <% } %>
            </div>

            <div class="border-top pt-2 mb-3 mt-auto small">
              <div class="d-flex justify-content-between text-muted">
                <span><i class="bi bi-person me-1"></i><%= item.contact_name || 'Chính chủ' %></span>
                <span><i class="bi bi-telephone me-1 text-success"></i><strong><%= item.contact_phone || '---' %></strong></span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2">
              <a href="/facebook/ai-write/<%= item.id %>" class="btn btn-gradient-primary btn-sm flex-grow-1 rounded-pill fw-bold shadow-sm">
                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Viết Bài AI
              </a>
              <button class="btn btn-outline-secondary btn-sm rounded-pill px-2.5" onclick="openEditModal(<%= JSON.stringify(item) %>)" title="Chỉnh sửa">
                <i class="bi bi-pencil"></i>
              </button>
              <form action="/listings/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xoá BĐS này?');" class="d-inline">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2.5" title="Xoá">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12 text-center py-5">
      <div class="p-5 bg-body-tertiary rounded-4 border">
        <i class="bi bi-house-door fs-1 text-muted d-block mb-3"></i>
        <h5>Kho bất động sản đang trống</h5>
        <p class="text-muted">Thêm bất động sản đầu tiên để trải nghiệm tính năng viết bài và đăng tin bằng AI!</p>
        <button class="btn btn-gradient-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addListingModal">
          <i class="bi bi-plus-circle me-1"></i> Thêm BĐS Ngay
        </button>
      </div>
    </div>
  <% } %>
</div>

<!-- Modal: Thêm BĐS Mới -->
<div class="modal fade" id="addListingModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Bất Động Sản Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/listings/create" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-semibold">Tiêu đề BĐS <span class="text-danger">*</span></label>
              <input type="text" name="title" class="form-control" placeholder="VD: Bán nhà phố mặt tiền Bình Thạnh - 4 tầng hiện đại" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Địa chỉ / Vị trí <span class="text-danger">*</span></label>
              <input type="text" name="address" class="form-control" placeholder="VD: 125 Đinh Bộ Lĩnh, P.26, Bình Thạnh, TP.HCM" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Giá bán (Tỷ VNĐ) <span class="text-danger">*</span></label>
              <input type="number" step="0.01" name="price" class="form-control" placeholder="VD: 8.5" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Diện tích (m²)</label>
              <input type="number" step="0.1" name="area" class="form-control" placeholder="VD: 85">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Số phòng ngủ</label>
              <input type="number" name="bedrooms" class="form-control" placeholder="VD: 4" value="0">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Số phòng tắm/WC</label>
              <input type="number" name="bathrooms" class="form-control" placeholder="VD: 4" value="0">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Hướng nhà</label>
              <select name="direction" class="form-select">
                <option value="Đông Nam">Đông Nam</option>
                <option value="Nam">Nam</option>
                <option value="Đông">Đông</option>
                <option value="Tây Nam">Tây Nam</option>
                <option value="Tây">Tây</option>
                <option value="Tây Bắc">Tây Bắc</option>
                <option value="Bắc">Bắc</option>
                <option value="Đông Bắc">Đông Bắc</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Pháp lý</label>
              <input type="text" name="legal" class="form-control" placeholder="VD: Sổ hồng riêng" value="Sổ hồng riêng">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Nội thất bàn giao</label>
              <input type="text" name="interior" class="form-control" placeholder="VD: Full nội thất cao cấp">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Link Hình ảnh (URL)</label>
              <input type="url" name="images" class="form-control" placeholder="https://images.unsplash.com/photo-...">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Tên người liên hệ</label>
              <input type="text" name="contact_name" class="form-control" placeholder="VD: Nguyễn Văn A">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Số điện thoại / Zalo</label>
              <input type="text" name="contact_phone" class="form-control" placeholder="VD: 0908123456">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả chi tiết / Tiện ích xung quanh</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Nhà gần trường học, bệnh viện, đường trước nhà 6m xe hơi tránh nhau..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-body-tertiary">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-gradient-primary rounded-pill px-4 fw-bold">Lưu Bất Động Sản</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Sửa BĐS -->
<div class="modal fade" id="editListingModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Bất Động Sản</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editListingForm" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-semibold">Tiêu đề BĐS</label>
              <input type="text" id="edit_title" name="title" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Địa chỉ / Vị trí</label>
              <input type="text" id="edit_address" name="address" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Giá bán (Tỷ VNĐ)</label>
              <input type="number" step="0.01" id="edit_price" name="price" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Diện tích (m²)</label>
              <input type="number" step="0.1" id="edit_area" name="area" class="form-control">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Số phòng ngủ</label>
              <input type="number" id="edit_bedrooms" name="bedrooms" class="form-control">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Số phòng tắm</label>
              <input type="number" id="edit_bathrooms" name="bathrooms" class="form-control">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Hướng nhà</label>
              <input type="text" id="edit_direction" name="direction" class="form-control">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Pháp lý</label>
              <input type="text" id="edit_legal" name="legal" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Nội thất bàn giao</label>
              <input type="text" id="edit_interior" name="interior" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Link Hình ảnh (URL)</label>
              <input type="url" id="edit_images" name="images" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Tên người liên hệ</label>
              <input type="text" id="edit_contact_name" name="contact_name" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Số điện thoại / Zalo</label>
              <input type="text" id="edit_contact_phone" name="contact_phone" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả chi tiết</label>
              <textarea id="edit_description" name="description" class="form-control" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-body-tertiary">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-gradient-primary rounded-pill px-4 fw-bold">Cập Nhật</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openEditModal(item) {
    document.getElementById('editListingForm').action = '/listings/update/' + item.id;
    document.getElementById('edit_title').value = item.title || '';
    document.getElementById('edit_address').value = item.address || '';
    document.getElementById('edit_price').value = item.price || 0;
    document.getElementById('edit_area').value = item.area || 0;
    document.getElementById('edit_bedrooms').value = item.bedrooms || 0;
    document.getElementById('edit_bathrooms').value = item.bathrooms || 0;
    document.getElementById('edit_direction').value = item.direction || '';
    document.getElementById('edit_legal').value = item.legal || '';
    document.getElementById('edit_interior').value = item.interior || '';
    document.getElementById('edit_images').value = item.images || '';
    document.getElementById('edit_contact_name').value = item.contact_name || '';
    document.getElementById('edit_contact_phone').value = item.contact_phone || '';
    document.getElementById('edit_description').value = item.description || '';

    const modal = new bootstrap.Modal(document.getElementById('editListingModal'));
    modal.show();
  }

  function filterListings() {
    const q = document.getElementById('listingSearchInput').value.toLowerCase().trim();
    const priceFilter = document.getElementById('priceFilter').value;
    const items = document.querySelectorAll('.listing-item');
    let visibleCount = 0;

    items.forEach(el => {
      const title = el.getAttribute('data-title') || '';
      const address = el.getAttribute('data-address') || '';
      const phone = el.getAttribute('data-phone') || '';
      const price = parseFloat(el.getAttribute('data-price')) || 0;

      let matchesSearch = !q || title.includes(q) || address.includes(q) || phone.includes(q);
      let matchesPrice = true;

      if (priceFilter === 'under_3') {
        matchesPrice = price > 0 && price < 3;
      } else if (priceFilter === '3_to_7') {
        matchesPrice = price >= 3 && price <= 7;
      } else if (priceFilter === 'above_7') {
        matchesPrice = price > 7;
      }

      if (matchesSearch && matchesPrice) {
        el.style.display = 'block';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    document.getElementById('totalListingsCount').textContent = visibleCount;
  }
</script>
