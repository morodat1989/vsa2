<style>
  .listing-row.selected-row {
    background-color: rgba(37, 99, 235, 0.08) !important;
  }
  .card-listing-box.selected-card {
    border: 2px solid var(--bs-primary) !important;
    background-color: rgba(37, 99, 235, 0.03);
  }
</style>

<script>
  // Global selected IDs Set
  let selectedIds = new Set();

  function switchView(mode) {
    const tableView = document.getElementById('tableViewContainer');
    const gridView = document.getElementById('listingsContainer');
    const btnTable = document.getElementById('btnTableView');
    const btnGrid = document.getElementById('btnGridView');

    if (mode === 'grid') {
      tableView.style.display = 'none';
      gridView.style.display = 'flex';
      btnTable.classList.remove('active');
      btnGrid.classList.add('active');
      localStorage.setItem('listings_view_mode', 'grid');
    } else {
      tableView.style.display = 'block';
      gridView.style.display = 'none';
      btnTable.classList.add('active');
      btnGrid.classList.remove('active');
      localStorage.setItem('listings_view_mode', 'table');
    }
  }

  // Restore saved view mode
  document.addEventListener('DOMContentLoaded', () => {
    const savedMode = localStorage.getItem('listings_view_mode') || 'table';
    switchView(savedMode);
    updateSelectionUI();
  });

  // Handle individual row checkbox toggle
  function handleRowCheckboxChange(id, isChecked) {
    id = Number(id);
    if (isChecked) {
      selectedIds.add(id);
    } else {
      selectedIds.delete(id);
    }
    syncCheckboxElements(id, isChecked);
    updateSelectionUI();
  }

  // Sync checkboxes across both table and grid views
  function syncCheckboxElements(id, isChecked) {
    const tableCb = document.getElementById('check-table-' + id);
    const cardCb = document.getElementById('check-card-' + id);
    const rowEl = document.getElementById('row-' + id);
    const cardEl = document.getElementById('card-' + id);

    if (tableCb) tableCb.checked = isChecked;
    if (cardCb) cardCb.checked = isChecked;

    if (rowEl) {
      if (isChecked) rowEl.classList.add('selected-row');
      else rowEl.classList.remove('selected-row');
    }

    if (cardEl) {
      const cardBox = cardEl.querySelector('.card-listing-box');
      if (cardBox) {
        if (isChecked) cardBox.classList.add('selected-card');
        else cardBox.classList.remove('selected-card');
      }
    }
  }

  // Master Checkbox Toggle (Select/Deselect visible items)
  function toggleSelectAll(isChecked) {
    const visibleRows = getVisibleElements();
    visibleRows.forEach(el => {
      const id = Number(el.getAttribute('data-id'));
      if (id) {
        if (isChecked) {
          selectedIds.add(id);
        } else {
          selectedIds.delete(id);
        }
        syncCheckboxElements(id, isChecked);
      }
    });
    updateSelectionUI();
  }

  // Select all visible listings
  function selectAllVisible() {
    toggleSelectAll(true);
  }

  // Deselect all
  function deselectAll() {
    selectedIds.clear();
    document.querySelectorAll('.listing-checkbox').forEach(cb => {
      cb.checked = false;
    });
    document.querySelectorAll('.listing-row').forEach(r => r.classList.remove('selected-row'));
    document.querySelectorAll('.card-listing-box').forEach(c => c.classList.remove('selected-card'));
    updateSelectionUI();
  }

  // Get currently visible items based on search/filter
  function getVisibleElements() {
    const mode = localStorage.getItem('listings_view_mode') || 'table';
    if (mode === 'grid') {
      return Array.from(document.querySelectorAll('.listing-card-item')).filter(el => el.style.display !== 'none');
    }
    return Array.from(document.querySelectorAll('.listing-row')).filter(el => el.style.display !== 'none');
  }

  // Update selection UI (Toolbar, badges, master checkbox indeterminate state)
  function updateSelectionUI() {
    const count = selectedIds.size;
    const bulkBar = document.getElementById('bulkActionBar');
    const badge = document.getElementById('selectedCountBadge');
    const masterCb = document.getElementById('masterCheckbox');
    const bulkBarCb = document.getElementById('bulkBarSelectAll');

    if (badge) badge.textContent = count;

    if (count > 0) {
      bulkBar.style.display = 'block';
    } else {
      bulkBar.style.display = 'none';
    }

    // Determine master checkbox state based on visible items
    const visibleElements = getVisibleElements();
    const visibleCount = visibleElements.length;

    let selectedVisibleCount = 0;
    visibleElements.forEach(el => {
      const id = Number(el.getAttribute('data-id'));
      if (selectedIds.has(id)) {
        selectedVisibleCount++;
      }
    });

    const isAllVisibleSelected = visibleCount > 0 && selectedVisibleCount === visibleCount;
    const isSomeVisibleSelected = selectedVisibleCount > 0 && selectedVisibleCount < visibleCount;

    if (masterCb) {
      masterCb.checked = isAllVisibleSelected;
      masterCb.indeterminate = isSomeVisibleSelected;
    }
    if (bulkBarCb) {
      bulkBarCb.checked = isAllVisibleSelected;
      bulkBarCb.indeterminate = isSomeVisibleSelected;
    }
  }

  // Filter listings
  function filterListings() {
    const q = document.getElementById('listingSearchInput').value.toLowerCase().trim();
    const priceFilter = document.getElementById('priceFilter').value;
    const statusFilter = document.getElementById('statusFilter').value;

    const rows = document.querySelectorAll('.listing-row');
    const cards = document.querySelectorAll('.listing-card-item');

    let visibleCount = 0;

    function checkItem(el) {
      const title = el.getAttribute('data-title') || '';
      const address = el.getAttribute('data-address') || '';
      const phone = el.getAttribute('data-phone') || '';
      const contact = el.getAttribute('data-contact') || '';
      const price = parseFloat(el.getAttribute('data-price')) || 0;
      const status = el.getAttribute('data-status') || 'available';

      let matchesSearch = !q || title.includes(q) || address.includes(q) || phone.includes(q) || contact.includes(q);
      let matchesPrice = true;
      let matchesStatus = (statusFilter === 'all' || status === statusFilter);

      if (priceFilter === 'under_3') {
        matchesPrice = price > 0 && price < 3;
      } else if (priceFilter === '3_to_7') {
        matchesPrice = price >= 3 && price <= 7;
      } else if (priceFilter === 'above_7') {
        matchesPrice = price > 7;
      }

      return matchesSearch && matchesPrice && matchesStatus;
    }

    rows.forEach(el => {
      const isVisible = checkItem(el);
      el.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });

    cards.forEach(el => {
      const isVisible = checkItem(el);
      el.style.display = isVisible ? 'block' : 'none';
    });

    document.getElementById('visibleListingsCount').textContent = visibleCount;
    updateSelectionUI();
  }

  function clearSearch() {
    document.getElementById('listingSearchInput').value = '';
    filterListings();
  }

  // Open Bulk Delete Modal
  function openBulkDeleteModal() {
    if (selectedIds.size === 0) {
      if (typeof showToast === 'function') showToast('Vui lòng chọn ít nhất một bất động sản!', false);
      return;
    }
    document.getElementById('bulkDeleteCountText').textContent = selectedIds.size;
    const modal = new bootstrap.Modal(document.getElementById('bulkDeleteModal'));
    modal.show();
  }

  // Execute Bulk Delete via fetch
  async function executeBulkDelete() {
    const ids = Array.from(selectedIds);
    if (ids.length === 0) return;

    const btn = document.getElementById('confirmBulkDeleteBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xóa...';

    try {
      const res = await fetch('/listings/bulk-delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ ids })
      });
      const data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || `Đã xóa ${ids.length} BĐS thành công!`);
        // Remove deleted items from DOM
        ids.forEach(id => {
          const row = document.getElementById('row-' + id);
          const card = document.getElementById('card-' + id);
          if (row) row.remove();
          if (card) card.remove();
          selectedIds.delete(id);
        });
        bootstrap.Modal.getInstance(document.getElementById('bulkDeleteModal')).hide();
        filterListings();
        updateSelectionUI();
      } else {
        alert(data.message || 'Lỗi khi xóa hàng loạt');
      }
    } catch (err) {
      console.error(err);
      alert('Lỗi kết nối máy chủ: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-trash3 me-1"></i> Đồng Ý Xóa';
    }
  }

  // Bulk update status via fetch
  async function bulkUpdateStatus(newStatus) {
    const ids = Array.from(selectedIds);
    if (ids.length === 0) {
      if (typeof showToast === 'function') showToast('Vui lòng chọn ít nhất một bất động sản!', false);
      return;
    }

    try {
      const res = await fetch('/listings/bulk-status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ ids, status: newStatus })
      });
      const data = await res.json();
      if (data.success) {
        if (typeof showToast === 'function') showToast(data.message || 'Cập nhật trạng thái thành công!');
        
        // Update DOM for each updated item
        ids.forEach(id => {
          updateItemStatusInDOM(id, newStatus);
        });
        deselectAll();
      } else {
        alert(data.message || 'Lỗi khi cập nhật trạng thái');
      }
    } catch (err) {
      console.error(err);
      alert('Lỗi kết nối máy chủ: ' + err.message);
    }
  }

  // Single status update helper
  async function singleUpdateStatus(id, newStatus) {
    try {
      const res = await fetch('/listings/bulk-status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ ids: [id], status: newStatus })
      });
      const data = await res.json();
      if (data.success) {
        updateItemStatusInDOM(id, newStatus);
        if (typeof showToast === 'function') showToast(data.message || 'Đã cập nhật trạng thái!');
      }
    } catch (err) {
      console.error(err);
    }
  }

  function updateItemStatusInDOM(id, newStatus) {
    const statusLabels = {
      available: 'Đang bán',
      reserved: 'Đã cọc',
      sold: 'Đã chốt',
      paused: 'Tạm ngưng'
    };
    const statusClasses = {
      available: 'btn-success text-white',
      reserved: 'btn-warning text-dark',
      sold: 'btn-secondary text-white',
      paused: 'btn-danger text-white'
    };

    const row = document.getElementById('row-' + id);
    const card = document.getElementById('card-' + id);

    if (row) {
      row.setAttribute('data-status', newStatus);
      const labelEl = document.getElementById('status-label-' + id);
      const btnEl = row.querySelector('.status-btn-' + id);
      if (labelEl) labelEl.textContent = statusLabels[newStatus] || newStatus;
      if (btnEl) {
        btnEl.className = `btn btn-sm dropdown-toggle rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1 status-btn-${id} ${statusClasses[newStatus]}`;
      }
    }

    if (card) {
      card.setAttribute('data-status', newStatus);
      const badge = card.querySelector('.badge.position-absolute');
      if (badge) {
        badge.textContent = statusLabels[newStatus] || newStatus;
        badge.className = `badge ${newStatus === 'reserved' ? 'bg-warning text-dark' : (newStatus === 'sold' ? 'bg-secondary' : (newStatus === 'paused' ? 'bg-danger' : 'bg-success'))} rounded-pill px-2.5 py-1 shadow-sm`;
      }
    }
  }

  // Single delete confirmation
  function confirmSingleDelete(id, title) {
    document.getElementById('singleDeleteForm').action = '/listings/delete/' + id;
    document.getElementById('singleDeleteTitleText').textContent = title || ('BĐS #' + id);
    const modal = new bootstrap.Modal(document.getElementById('singleDeleteModal'));
    modal.show();
  }

  // Open Edit Modal
  function openEditModal(item) {
    document.getElementById('editListingForm').action = '/listings/update/' + item.id;
    document.getElementById('edit_title').value = item.title || '';
    document.getElementById('edit_address').value = item.address || '';
    document.getElementById('edit_price').value = item.price || 0;
    document.getElementById('edit_area').value = item.area || 0;
    document.getElementById('edit_status').value = item.status || 'available';
    document.getElementById('edit_bedrooms').value = item.bedrooms || 0;
    document.getElementById('edit_bathrooms').value = item.bathrooms || 0;
    document.getElementById('edit_direction').value = item.direction || '';
    document.getElementById('edit_legal').value = item.legal || '';
    document.getElementById('edit_interior').value = item.interior || '';
    document.getElementById('edit_images').value = item.images || '';
    document.getElementById('edit_contact_name').value = item.contact_name || '';
    document.getElementById('edit_contact_phone').value = item.contact_phone || '';
    document.getElementById('edit_description').value = item.description || '';

    const modal = new bootstrap.Modal(document.getElementById('editListingModal'));
    modal.show();
  }
</script>
