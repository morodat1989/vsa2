<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1"><i class="fa-solid fa-users-rectangle text-primary me-2"></i>Quản Lý Nhóm Facebook</h4>
    <p class="text-muted small mb-0">Quản lý các hội nhóm bất động sản đã tham gia để phân phối bài đăng</p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#scanGroupModal">
      <i class="bi bi-search me-1"></i> Quét Nhóm Tự Động
    </button>
    <button class="btn btn-gradient-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addGroupModal">
      <i class="bi bi-plus-circle me-1"></i> Thêm Nhóm Mới
    </button>
  </div>
</div>

<!-- Filters Bar -->
<div class="card shadow-sm border-0 mb-4 bg-body">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-4">
        <label class="small text-muted fw-semibold">Lọc theo tài khoản:</label>
        <select class="form-select form-select-sm" id="accountFilter" onchange="applyFilters()">
          <option value="all">Tất cả tài khoản (<%= accounts.length %>)</option>
          <% accounts.forEach(acc => { %>
            <option value="<%= acc.id %>" <%= (selectedAccountId == acc.id) ? 'selected' : '' %>>
              <%= acc.name %> (<%= acc.groups_count || 0 %> nhóm)
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="small text-muted fw-semibold">Quyền đăng bài:</label>
        <select class="form-select form-select-sm" id="permissionFilter" onchange="applyFilters()">
          <option value="all">Tất cả quyền duyệt</option>
          <option value="auto_approve">Duyệt tự động (Tự do)</option>
          <option value="pending">Phải chờ admin duyệt</option>
        </select>
      </div>

      <div class="col-md-5">
        <label class="small text-muted fw-semibold">Tìm kiếm nhóm:</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
          <input type="text" id="groupSearchInput" class="form-control" placeholder="Tìm theo tên nhóm hoặc ID..." onkeyup="applyFilters()">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Groups Table -->
<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Tên Nhóm / ID</th>
            <th>Quyền Phê Duyệt</th>
            <th>Thành Viên</th>
            <th>Quyền Riêng Tư</th>
            <th>Tài Khoản Liên Kết</th>
            <th class="text-end pe-4">Thao Tác</th>
          </tr>
        </thead>
        <tbody id="groupsTableBody">
          <% if (groups && groups.length > 0) { %>
            <% groups.forEach(grp => { 
                const acc = accounts.find(a => a.id === grp.account_id);
            %>
              <tr class="group-row" 
                  data-name="<%= grp.name.toLowerCase() %>" 
                  data-id="<%= grp.group_id %>"
                  data-account="<%= grp.account_id %>"
                  data-permission="<%= grp.post_permission %>">
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-users text-primary fs-5"></i>
                    <div>
                      <a href="https://facebook.com/groups/<%= grp.group_id %>" target="_blank" class="fw-bold text-decoration-none text-body">
                        <%= grp.name %> <i class="bi bi-box-arrow-up-right small text-muted" style="font-size: 0.75rem;"></i>
                      </a>
                      <div class="small text-muted font-monospace">ID: <%= grp.group_id %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge <%= grp.post_permission === 'auto_approve' ? 'badge-soft-success' : 'badge-soft-warning' %> px-2.5 py-1">
                    <i class="bi <%= grp.post_permission === 'auto_approve' ? 'bi-check2-circle' : 'bi-shield-exclamation' %> me-1"></i>
                    <%= grp.post_permission === 'auto_approve' ? 'Tự do đăng (Auto)' : 'Kiểm duyệt (Pending)' %>
                  </span>
                </td>
                <td>
                  <span class="fw-semibold"><%= grp.member_count ? Number(grp.member_count).toLocaleString('vi-VN') : '---' %></span>
                </td>
                <td>
                  <span class="badge bg-body-secondary text-body">
                    <%= grp.privacy === 'PUBLIC' ? 'Công khai' : 'Kín' %>
                  </span>
                </td>
                <td>
                  <span class="small fw-semibold text-truncate d-inline-block" style="max-width: 180px;">
                    <i class="fa-brands fa-facebook text-primary me-1"></i><%= acc ? acc.name : 'Tài khoản #' + grp.account_id %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <form action="/facebook/groups/delete/<%= grp.id %>" method="POST" onsubmit="return confirm('Bạn có chắc muốn xoá nhóm này?');" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Xoá">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="fa-solid fa-users-slash fs-1 text-secondary d-block mb-3"></i>
                Chưa có nhóm nào. Bấm <b>"Quét Nhóm Tự Động"</b> để bắt đầu!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ================= MODAL: QUÉT NHÓM TỰ ĐỘNG ================= -->
<div class="modal fade" id="scanGroupModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header border-bottom bg-primary bg-opacity-10">
        <h5 class="modal-title fw-bold text-primary">
          <i class="bi bi-search me-2"></i>Quét Nhóm Facebook Tự Động
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="closeScanModalBtn"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Chế độ chọn quét -->
        <div class="mb-4">
          <label class="form-label fw-bold mb-2 text-dark">
            <i class="bi bi-check2-square text-primary me-1"></i> 1. Chọn chế độ quét nhóm:
          </label>
          <div class="row g-2">
            <div class="col-md-6">
              <div class="card h-100 border p-3 cursor-pointer option-card active-option" id="cardOption5" onclick="selectScanOption(5)">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="scanMode" id="mode5" value="5" checked>
                  <label class="form-check-label fw-bold" for="mode5">
                    Quét nhanh 5 nhóm
                    <span class="badge bg-success-subtle text-success ms-1 small">Khuyên dùng</span>
                  </label>
                  <div class="text-muted small mt-1">
                    Lấy 5 nhóm đầu tiên, hoàn tất nhanh trong ~15s, an toàn tối đa cho nick mới.
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card h-100 border p-3 cursor-pointer option-card" id="cardOptionAll" onclick="selectScanOption(0)">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="scanMode" id="modeAll" value="0">
                  <label class="form-check-label fw-bold" for="modeAll">
                    Quét tất cả nhóm
                    <span class="badge bg-primary-subtle text-primary ms-1 small">Toàn bộ</span>
                  </label>
                  <div class="text-muted small mt-1">
                    Duyệt qua tất cả các nhóm đã tham gia với cơ chế nghỉ ngắt quãng.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Cài đặt nghỉ ngơi chống checkpoint -->
        <div class="mb-4 p-3 rounded-3 bg-light border border-warning-subtle">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold mb-0 text-dark">
              <i class="bi bi-shield-check text-warning me-1"></i> 2. Cơ chế nghỉ giữa chừng (Chống Checkpoint / Chết nick):
            </label>
            <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill me-1"></i>Bảo vệ FB</span>
          </div>
          
          <div class="row g-2 align-items-center mt-1">
            <div class="col-md-5">
              <select id="scanDelaySelect" class="form-select">
                <option value="2.0">Nghỉ 2 giây / nhóm (Nhanh)</option>
                <option value="3.0" selected>Nghỉ 3 giây / nhóm (Khuyên dùng - Cân bằng)</option>
                <option value="5.0">Nghỉ 5 giây / nhóm (Cực kỳ an toàn - Nick mới)</option>
              </select>
            </div>
            <div class="col-md-7">
              <span class="text-muted small">
                <i class="bi bi-info-circle text-info me-1"></i>Hệ thống tự động thêm độ lệch ngẫu nhiên để mô phỏng hành vi người dùng thật, tránh Facebook quét spam.
              </span>
            </div>
          </div>
        </div>

        <!-- Hộp tiến trình và Log trực tiếp -->
        <div id="scanProgressArea" style="display: none;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-bold small text-primary" id="scanStatusTitle">Đang chuẩn bị quét...</span>
            <span class="badge bg-primary" id="scanProgressPercent">0%</span>
          </div>

          <div class="progress mb-3" style="height: 10px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="scanProgressBar" role="progressbar" style="width: 0%"></div>
          </div>

          <!-- Console Terminal Log -->
          <div class="bg-dark text-light p-3 rounded-3 font-monospace small mb-3" style="max-height: 180px; overflow-y: auto;" id="scanTerminalLog">
            <div class="text-secondary">[Sẵn sàng] Bấm "Bắt Đầu Quét & Lưu" để tiến hành...</div>
          </div>
        </div>

        <!-- Kết quả sau khi quét -->
        <div id="scanResultAlert" class="alert alert-success d-none mb-0" role="alert">
          <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
          <span id="scanResultText">Quét và lưu nhóm thành công!</span>
        </div>
      </div>

      <div class="modal-footer border-top bg-light">
        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal" id="btnCancelScan">Hủy Bỏ</button>
        <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnStartScan" onclick="startScanningProcess()">
          <i class="bi bi-play-fill me-1"></i> Bắt Đầu Quét & Lưu
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Thêm Nhóm Mới Thủ Công -->
<div class="modal fade" id="addGroupModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Nhóm Facebook Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/facebook/groups/create" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-semibold">Tài khoản sở hữu <span class="text-danger">*</span></label>
              <select name="account_id" class="form-select" required>
                <% accounts.forEach(acc => { %>
                  <option value="<%= acc.id %>"><%= acc.name %> (UID: <%= acc.uid %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Tên nhóm Facebook <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="VD: BẤT ĐỘNG SẢN BÌNH THẠNH CHÍNH CHỦ" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Facebook Group ID <span class="text-danger">*</span></label>
              <input type="text" name="group_id" class="form-control" placeholder="VD: 1092837465012" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Quyền đăng bài</label>
              <select name="post_permission" class="form-select">
                <option value="auto_approve">Tự do (Auto approve)</option>
                <option value="pending">Chờ duyệt (Pending)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Số lượng thành viên</label>
              <input type="number" name="member_count" class="form-control" placeholder="VD: 50000" value="50000">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Quyền riêng tư</label>
              <select name="privacy" class="form-select">
                <option value="PUBLIC">Công khai (Public)</option>
                <option value="CLOSED">Nhóm kín (Closed)</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-body-tertiary">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-gradient-primary rounded-pill px-4 fw-bold">Lưu Nhóm</button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .cursor-pointer { cursor: pointer; }
  .option-card {
    transition: all 0.2s ease-in-out;
  }
  .option-card:hover {
    border-color: #0d6efd !important;
    background-color: rgba(13, 110, 253, 0.02);
  }
  .active-option {
    border-color: #0d6efd !important;
    background-color: rgba(13, 110, 253, 0.05) !important;
  }
</style>

<script>
  let currentScanMode = 5;

  function selectScanOption(mode) {
    currentScanMode = mode;
    const card5 = document.getElementById('cardOption5');
    const cardAll = document.getElementById('cardOptionAll');
    const r5 = document.getElementById('mode5');
    const rAll = document.getElementById('modeAll');

    if (mode === 5) {
      card5.classList.add('active-option');
      cardAll.classList.remove('active-option');
      r5.checked = true;
    } else {
      cardAll.classList.add('active-option');
      card5.classList.remove('active-option');
      rAll.checked = true;
    }
  }

  function appendTerminalLog(msg, colorClass = 'text-light') {
    const term = document.getElementById('scanTerminalLog');
    const p = document.createElement('div');
    p.className = colorClass + ' mb-1';
    p.textContent = msg;
    term.appendChild(p);
    term.scrollTop = term.scrollHeight;
  }

  async function startScanningProcess() {
    const btnStart = document.getElementById('btnStartScan');
    const btnCancel = document.getElementById('btnCancelScan');
    const closeBtn = document.getElementById('closeScanModalBtn');
    const progressArea = document.getElementById('scanProgressArea');
    const progressBar = document.getElementById('scanProgressBar');
    const percentEl = document.getElementById('scanProgressPercent');
    const statusTitle = document.getElementById('scanStatusTitle');
    const term = document.getElementById('scanTerminalLog');
    const resultAlert = document.getElementById('scanResultAlert');
    const delayVal = parseFloat(document.getElementById('scanDelaySelect').value) || 3.0;

    btnStart.disabled = true;
    btnCancel.disabled = true;
    closeBtn.disabled = true;
    btnStart.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang quét...';
    
    progressArea.style.display = 'block';
    resultAlert.classList.add('d-none');
    term.innerHTML = '';

    appendTerminalLog(`[Bắt đầu] Chế độ: ${currentScanMode === 5 ? 'Quét 5 nhóm nhanh' : 'Quét tất cả nhóm'}`);
    appendTerminalLog(`[Bảo vệ FB] Nghỉ giữa chừng: ${delayVal}s/nhóm để chống Checkpoint...`, 'text-warning');
    
    progressBar.style.width = '25%';
    percentEl.textContent = '25%';
    statusTitle.textContent = 'Đang kết nối phiên duyệt Facebook...';

    try {
      const res = await fetch('/facebook/groups/scan', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          limit: currentScanMode,
          delay: delayVal
        })
      });

      const data = await res.json();

      if (data.success) {
        progressBar.style.width = '100%';
        percentEl.textContent = '100%';
        progressBar.classList.remove('bg-primary');
        progressBar.classList.add('bg-success');
        statusTitle.textContent = '✅ Đã hoàn tất và lưu vào cơ sở dữ liệu!';

        if (Array.isArray(data.logs)) {
          term.innerHTML = '';
          data.logs.forEach(l => {
            const isRest = l.includes('nghỉ') || l.includes('⏸️');
            const isDone = l.includes('Hoàn tất') || l.includes('Thành công');
            appendTerminalLog(l, isDone ? 'text-success fw-bold' : (isRest ? 'text-warning' : 'text-light'));
          });
        }

        resultAlert.classList.remove('d-none');
        document.getElementById('scanResultText').textContent = 
          `Đã quét thành công ${data.count} nhóm (${data.new_count || data.saved_count} nhóm mới) và lưu vào cơ sở dữ liệu an toàn!`;

        btnStart.innerHTML = '<i class="bi bi-check-lg me-1"></i> Đã Lưu Xong';
        btnCancel.textContent = 'Đóng & Xem Danh Sách';
        btnCancel.disabled = false;
        closeBtn.disabled = false;

        btnCancel.onclick = () => window.location.reload();
        closeBtn.onclick = () => window.location.reload();
      } else {
        throw new Error(data.message || 'Lỗi quét nhóm');
      }
    } catch (err) {
      console.error(err);
      appendTerminalLog(`[LỖI] ${err.message}`, 'text-danger fw-bold');
      statusTitle.textContent = '⚠️ Có lỗi xảy ra trong quá trình quét';
      progressBar.classList.remove('bg-primary');
      progressBar.classList.add('bg-danger');
      btnStart.disabled = false;
      btnCancel.disabled = false;
      closeBtn.disabled = false;
      btnStart.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Thử Lại';
    }
  }

  function applyFilters() {
    const accId = document.getElementById('accountFilter').value;
    const perm = document.getElementById('permissionFilter').value;
    const q = document.getElementById('groupSearchInput').value.toLowerCase().trim();

    const rows = document.querySelectorAll('.group-row');
    rows.forEach(r => {
      const rowName = r.getAttribute('data-name') || '';
      const rowId = r.getAttribute('data-id') || '';
      const rowAcc = r.getAttribute('data-account');
      const rowPerm = r.getAttribute('data-permission');

      const matchAcc = (accId === 'all' || rowAcc === accId);
      const matchPerm = (perm === 'all' || rowPerm === perm);
      const matchSearch = (!q || rowName.includes(q) || rowId.includes(q));

      if (matchAcc && matchPerm && matchSearch) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });
  }
</script>
