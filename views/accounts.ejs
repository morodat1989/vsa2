<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Tài Khoản Facebook</h4>
    <p class="text-muted small mb-0">Quản lý dàn nick Facebook đăng bài, kiểm tra tình trạng Live/Die và quét danh sách nhóm</p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-success rounded-pill px-3 shadow-sm" onclick="checkAllAccountsLive()">
      <i class="bi bi-shield-check me-1"></i> Kiểm Tra Tất Cả Live
    </button>
    <button class="btn btn-gradient-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
      <i class="bi bi-plus-circle me-1"></i> Thêm Tài Khoản
    </button>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Tài Khoản / UID</th>
            <th>Trạng Thái Live</th>
            <th>Cookie & Token</th>
            <th>Số Nhóm</th>
            <th>Lần Kiểm Tra Cuối</th>
            <th class="text-end pe-4">Thao Tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (accounts && accounts.length > 0) { %>
            <% accounts.forEach(acc => { %>
              <tr id="accountRow_<%= acc.id %>">
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary fs-5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                      <i class="fa-brands fa-facebook-f"></i>
                    </div>
                    <div>
                      <div class="fw-bold text-body"><%= acc.name %></div>
                      <div class="small text-muted font-monospace"><%= acc.uid %></div>
                      <% if (acc.proxy) { %>
                        <div class="small text-info"><i class="bi bi-hdd-network me-1"></i><%= acc.proxy %></div>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge <%= acc.live_status === 'live' ? 'badge-soft-success' : (acc.live_status === 'die' ? 'badge-soft-danger' : 'badge-soft-warning') %> px-2.5 py-1.5 fs-7" id="liveBadge_<%= acc.id %>">
                    <i class="bi <%= acc.live_status === 'live' ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i>
                    <%= acc.live_status === 'live' ? 'Live (Hoạt động)' : (acc.live_status === 'die' ? 'Die (Mất phiên)' : 'Chưa kiểm tra') %>
                  </span>
                </td>
                <td>
                  <div class="small text-muted font-monospace text-truncate" style="max-width: 220px;" title="<%= acc.cookie %>">
                    <i class="bi bi-cookie me-1"></i><%= acc.cookie ? acc.cookie.substring(0, 30) + '...' : 'Chưa có cookie' %>
                  </div>
                  <div class="small text-muted font-monospace text-truncate" style="max-width: 220px;" title="<%= acc.access_token %>">
                    <i class="bi bi-key me-1"></i><%= acc.access_token ? acc.access_token.substring(0, 20) + '...' : 'Chưa có token' %>
                  </div>
                </td>
                <td>
                  <a href="/facebook/groups?account_id=<%= acc.id %>" class="badge bg-body-secondary text-body text-decoration-none px-2.5 py-1.5 fw-bold">
                    <i class="bi bi-people-fill text-primary me-1"></i> <%= acc.groups_count || 0 %> nhóm
                  </a>
                </td>
                <td class="small text-muted">
                  <%= acc.last_check ? new Date(acc.last_check).toLocaleString('vi-VN') : '---' %>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-success" onclick="checkSingleAccountLive(<%= acc.id %>)" title="Kiểm tra Live">
                      <i class="bi bi-arrow-repeat"></i> Live
                    </button>
                    <button class="btn btn-outline-info" onclick="scanAccountGroups(<%= acc.id %>)" title="Quét danh sách nhóm">
                      <i class="bi bi-search"></i> Quét nhóm
                    </button>
                    <button class="btn btn-outline-secondary" onclick="openEditAccountModal(<%= JSON.stringify(acc) %>)" title="Sửa">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form action="/facebook/accounts/delete/<%= acc.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xoá tài khoản này?');" class="d-inline">
                      <button type="submit" class="btn btn-outline-danger" title="Xoá">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="fa-brands fa-facebook fs-1 text-secondary d-block mb-3"></i>
                Chưa có tài khoản Facebook nào trong hệ thống.<br>
                <button class="btn btn-gradient-primary rounded-pill px-4 mt-3" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                  Thêm Tài Khoản Đầu Tiên
                </button>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Thêm Tài Khoản Mới -->
<div class="modal fade" id="addAccountModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="fa-brands fa-facebook text-primary me-2"></i>Thêm Tài Khoản Facebook</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <ul class="nav nav-tabs px-4 pt-3 border-bottom-0" id="accountAddTabs" role="tablist">
        <li class="nav-item">
          <button class="nav-link active fw-bold" id="single-tab" data-bs-toggle="tab" data-bs-target="#singleAccountTab" type="button">Thêm Từng Nick</button>
        </li>
        <li class="nav-item">
          <button class="nav-link fw-bold" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulkAccountTab" type="button">Nhập Hàng Loạt (Bulk)</button>
        </li>
      </ul>

      <div class="tab-content" id="accountTabsContent">
        <!-- Single Account Form -->
        <div class="tab-pane fade show active" id="singleAccountTab">
          <form action="/facebook/accounts/create" method="POST">
            <div class="modal-body p-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Tên gợi nhớ tài khoản <span class="text-danger">*</span></label>
                  <input type="text" name="name" class="form-control" placeholder="VD: Nick Đăng Tin BĐS Quận 1" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Facebook UID</label>
                  <input type="text" name="uid" class="form-control" placeholder="VD: 100088923412345">
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Cookie Facebook</label>
                  <textarea name="cookie" class="form-control font-monospace" rows="3" placeholder="c_user=...; xs=...; datr=..."></textarea>
                  <div class="form-text">Paste toàn bộ chuỗi Cookie từ extension J2Team hoặc cCookie.</div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Access Token (EAA...)</label>
                  <input type="text" name="access_token" class="form-control font-monospace" placeholder="EAABsbCS1iHg...">
                  <div class="form-text">Dùng để quét danh sách nhóm tự động qua Graph API.</div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Proxy (IP:Port hoặc IP:Port:User:Pass)</label>
                  <input type="text" name="proxy" class="form-control font-monospace" placeholder="103.152.11.22:8080">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">User-Agent tùy chỉnh</label>
                  <input type="text" name="user_agent" class="form-control" placeholder="Để trống nếu dùng mặc định">
                </div>
              </div>
            </div>
            <div class="modal-footer border-top bg-body-tertiary">
              <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
              <button type="submit" class="btn btn-gradient-primary rounded-pill px-4 fw-bold">Lưu Tài Khoản</button>
            </div>
          </form>
        </div>

        <!-- Bulk Accounts Form -->
        <div class="tab-pane fade" id="bulkAccountTab">
          <form action="/facebook/accounts/bulk-import" method="POST">
            <div class="modal-body p-4">
              <div class="mb-3">
                <label class="form-label fw-semibold">Nhập danh sách tài khoản (mỗi dòng một nick):</label>
                <textarea name="bulk_data" class="form-control font-monospace" rows="8" placeholder="Định dạng hỗ trợ:
UID|Pass|2FA|Cookie|Token
hoặc
UID|Tên|Cookie
hoặc dán nguyên chuỗi Cookie c_user=..."></textarea>
                <div class="form-text mt-2">
                  Hệ thống tự động phân tích và trích xuất UID, Cookie, Token từ cấu trúc phân tách bằng dấu gạch đứng ( | ).
                </div>
              </div>
            </div>
            <div class="modal-footer border-top bg-body-tertiary">
              <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
              <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Nhập Hàng Loạt</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Sửa Tài Khoản -->
<div class="modal fade" id="editAccountModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập Nhật Tài Khoản Facebook</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editAccountForm" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Tên tài khoản</label>
              <input type="text" id="edit_acc_name" name="name" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Facebook UID</label>
              <input type="text" id="edit_acc_uid" name="uid" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Cookie Facebook</label>
              <textarea id="edit_acc_cookie" name="cookie" class="form-control font-monospace" rows="3"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Access Token</label>
              <input type="text" id="edit_acc_token" name="access_token" class="form-control font-monospace">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Proxy</label>
              <input type="text" id="edit_acc_proxy" name="proxy" class="form-control font-monospace">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Trạng thái</label>
              <select id="edit_acc_status" name="live_status" class="form-select">
                <option value="live">Live (Hoạt động)</option>
                <option value="die">Die (Mất phiên)</option>
                <option value="unknown">Chưa rõ</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top bg-body-tertiary">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-gradient-primary rounded-pill px-4 fw-bold">Lưu Thay Đổi</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openEditAccountModal(acc) {
    document.getElementById('editAccountForm').action = '/facebook/accounts/update/' + acc.id;
    document.getElementById('edit_acc_name').value = acc.name || '';
    document.getElementById('edit_acc_uid').value = acc.uid || '';
    document.getElementById('edit_acc_cookie').value = acc.cookie || '';
    document.getElementById('edit_acc_token').value = acc.access_token || '';
    document.getElementById('edit_acc_proxy').value = acc.proxy || '';
    document.getElementById('edit_acc_status').value = acc.live_status || 'unknown';

    new bootstrap.Modal(document.getElementById('editAccountModal')).show();
  }

  async function checkSingleAccountLive(id) {
    const badge = document.getElementById('liveBadge_' + id);
    if (badge) {
      badge.textContent = 'Đang kiểm tra...';
      badge.className = 'badge badge-soft-warning px-2.5 py-1.5';
    }

    try {
      const res = await fetch('/facebook/accounts/check-live/' + id, { method: 'POST' });
      const data = await res.json();
      if (data.live) {
        badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Live (Hoạt động)';
        badge.className = 'badge badge-soft-success px-2.5 py-1.5';
        showToast(data.message || 'Tài khoản hoạt động tốt!', true);
      } else {
        badge.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Die (Mất phiên)';
        badge.className = 'badge badge-soft-danger px-2.5 py-1.5';
        showToast(data.message || 'Tài khoản đã mất phiên!', false);
      }
    } catch (err) {
      showToast('Lỗi kiểm tra trạng thái', false);
    }
  }

  async function scanAccountGroups(id) {
    showToast('Đang quét danh sách nhóm cho tài khoản...', true);
    try {
      const res = await fetch('/facebook/accounts/scan-groups/' + id, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showToast(`Đã quét thành công ${data.count} nhóm!`, true);
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast(data.message || 'Lỗi quét nhóm', false);
      }
    } catch (err) {
      showToast('Lỗi kết nối máy chủ', false);
    }
  }

  async function checkAllAccountsLive() {
    showToast('Bắt đầu kiểm tra trạng thái toàn bộ nick...', true);
    const rows = document.querySelectorAll('[id^="accountRow_"]');
    for (const row of rows) {
      const id = row.id.replace('accountRow_', '');
      await checkSingleAccountLive(id);
      await new Promise(r => setTimeout(r, 400));
    }
  }
</script>
