<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1">Lịch Sử Đăng Bài</h4>
    <p class="text-muted small mb-0">Theo dõi toàn bộ bài viết đã được tự động đăng lên các hội nhóm Facebook</p>
  </div>
  <% if (logs && logs.length > 0) { %>
    <form action="/facebook/logs/clear" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ lịch sử đăng bài?');">
      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm">
        <i class="bi bi-trash me-1"></i> Xóa Lịch Sử
      </button>
    </form>
  <% } %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Thời Gian</th>
            <th>Tài Khoản FB</th>
            <th>Nhóm Đăng</th>
            <th>Bất Động Sản</th>
            <th>Trạng Thái</th>
            <th class="text-end pe-4">Chi Tiết</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs && logs.length > 0) { %>
            <% logs.forEach(log => { %>
              <tr>
                <td class="ps-4 small text-muted">
                  <i class="bi bi-clock me-1"></i><%= new Date(log.created_at).toLocaleString('vi-VN') %>
                </td>
                <td>
                  <div class="fw-semibold small"><i class="fa-brands fa-facebook text-primary me-1"></i><%= log.account_name %></div>
                </td>
                <td>
                  <div class="fw-semibold small text-truncate" style="max-width: 220px;" title="<%= log.group_name %>">
                    <i class="fa-solid fa-users text-info me-1"></i><%= log.group_name %>
                  </div>
                  <% if (log.fb_post_id) { %>
                    <div class="small text-muted font-monospace" style="font-size: 0.72rem;">ID: <%= log.fb_post_id %></div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-semibold small text-truncate" style="max-width: 260px;" title="<%= log.listing_title %>">
                    <%= log.listing_title || 'Bài đăng tự do' %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= log.status === 'success' ? 'badge-soft-success' : 'badge-soft-danger' %> px-2.5 py-1">
                    <i class="bi <%= log.status === 'success' ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i>
                    <%= log.status === 'success' ? 'Thành công' : 'Thất bại' %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="viewLogModal(<%= JSON.stringify(log) %>)">
                    <i class="bi bi-eye me-1"></i> Xem nội dung
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="fa-solid fa-clock-rotate-left fs-1 text-secondary d-block mb-3"></i>
                Chưa có lịch sử đăng bài nào.<br>
                Hãy vào mục <a href="/listings">Kho Bất Động Sản</a> và nhấn "Viết Bài AI" để bắt đầu đăng tin!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal xem nội dung log -->
<div class="modal fade" id="logDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-text text-primary me-2"></i>Nội Dung Bài Đăng Facebook</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3 d-flex flex-wrap gap-2 small">
          <span class="badge bg-body-secondary text-body" id="modalAccount"></span>
          <span class="badge bg-body-secondary text-body" id="modalGroup"></span>
          <span class="badge bg-body-secondary text-body" id="modalTime"></span>
        </div>
        <div class="p-3 rounded bg-body-tertiary border">
          <pre id="modalContent" class="mb-0" style="white-space: pre-wrap; font-family: inherit; font-size: 0.95rem;"></pre>
        </div>
      </div>
      <div class="modal-footer border-top bg-body-tertiary">
        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
  function viewLogModal(log) {
    document.getElementById('modalAccount').textContent = 'Nick: ' + (log.account_name || '---');
    document.getElementById('modalGroup').textContent = 'Nhóm: ' + (log.group_name || '---');
    document.getElementById('modalTime').textContent = new Date(log.created_at).toLocaleString('vi-VN');
    document.getElementById('modalContent').textContent = log.content || 'Không có nội dung';
    new bootstrap.Modal(document.getElementById('logDetailModal')).show();
  }
</script>
