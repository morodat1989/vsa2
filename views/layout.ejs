<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - FB Tool BĐS' : 'FB Tool Management - Quản Lý Bất Động Sản & Đăng Tin AI' %></title>
  <meta name="description" content="Quản lý Bất Động Sản & Mạng Xã Hội với công cụ AI tự động tạo bài đăng và quản trị tài khoản Facebook.">
  <meta property="og:title" content="FB Tool Management">
  <meta property="og:description" content="Quản lý Bất Động Sản & Mạng Xã Hội với công cụ AI tự động tạo bài đăng và quản trị tài khoản Facebook.">
  
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --primary-color: #2563eb;
      --primary-hover: #1d4ed8;
      --sidebar-width: 260px;
    }
    body {
      font-family: var(--font-family);
      background-color: var(--bs-body-bg);
      color: var(--bs-body-color);
      min-height: 100vh;
    }
    .app-sidebar {
      width: var(--sidebar-width);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 1000;
      background: var(--bs-tertiary-bg);
      border-right: 1px solid var(--bs-border-color);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease;
    }
    .app-main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    @media (max-width: 991.98px) {
      .app-sidebar {
        transform: translateX(-100%);
      }
      .app-sidebar.show {
        transform: translateX(0);
      }
      .app-main {
        margin-left: 0;
      }
    }
    .sidebar-brand {
      padding: 1.25rem 1.5rem;
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--bs-primary);
      display: flex;
      align-items: center;
      gap: 0.65rem;
      border-bottom: 1px solid var(--bs-border-color);
      text-decoration: none;
    }
    .nav-item-link {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 0.75rem 1.25rem;
      margin: 0.2rem 0.75rem;
      border-radius: 0.65rem;
      font-weight: 600;
      font-size: 0.925rem;
      color: var(--bs-secondary-color);
      text-decoration: none;
      transition: all 0.15s ease-in-out;
    }
    .nav-item-link:hover {
      color: var(--bs-primary);
      background-color: rgba(37, 99, 235, 0.08);
    }
    .nav-item-link.active {
      color: #fff;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }
    .stat-card {
      border: 1px solid var(--bs-border-color);
      border-radius: 1rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }
    .btn-gradient-primary {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: white;
      border: none;
    }
    .btn-gradient-primary:hover {
      background: linear-gradient(135deg, #1d4ed8, #1e40af);
      color: white;
    }
    .badge-soft-success {
      background-color: rgba(16, 185, 129, 0.15);
      color: #10b981;
    }
    .badge-soft-danger {
      background-color: rgba(239, 68, 68, 0.15);
      color: #ef4444;
    }
    .badge-soft-primary {
      background-color: rgba(37, 99, 235, 0.15);
      color: #2563eb;
    }
    .badge-soft-warning {
      background-color: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
    }
    .table th {
      font-weight: 700;
      font-size: 0.825rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
  </style>
</head>
<body>

  <!-- Mobile Overlay -->
  <div class="d-lg-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50" id="sidebarBackdrop" style="display:none; z-index: 999;" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="app-sidebar shadow-sm" id="appSidebar">
    <a href="/" class="sidebar-brand">
      <i class="fa-solid fa-building-circle-check fs-4"></i>
      <span>FB Tool BĐS</span>
    </a>

    <div class="px-3 py-3">
      <small class="text-uppercase fw-bold text-muted px-2" style="font-size: 0.72rem;">Quản Lý BĐS & Mạng Xã Hội</small>
    </div>

    <nav class="flex-grow-1 overflow-y-auto">
      <a href="/" class="nav-item-link <%= path === '/' ? 'active' : '' %>">
        <i class="fa-solid fa-chart-pie w-5"></i>
        <span>Tổng Quan</span>
      </a>
      <a href="/listings" class="nav-item-link <%= path.startsWith('/listings') ? 'active' : '' %>">
        <i class="fa-solid fa-house-chimney w-5"></i>
        <span>Kho Bất Động Sản</span>
      </a>
      <a href="/facebook/accounts" class="nav-item-link <%= path === '/facebook/accounts' ? 'active' : '' %>">
        <i class="fa-brands fa-facebook w-5"></i>
        <span>Tài Khoản FB</span>
      </a>
      <a href="/facebook/groups" class="nav-item-link <%= path === '/facebook/groups' ? 'active' : '' %>">
        <i class="fa-solid fa-users-rectangle w-5"></i>
        <span>Nhóm Đăng Bài</span>
      </a>
      <a href="/facebook/logs" class="nav-item-link <%= path === '/facebook/logs' ? 'active' : '' %>">
        <i class="fa-solid fa-clock-rotate-left w-5"></i>
        <span>Lịch Sử Đăng</span>
      </a>
      <a href="/settings" class="nav-item-link <%= path === '/settings' ? 'active' : '' %>">
        <i class="fa-solid fa-sliders w-5"></i>
        <span>Cài Đặt Hệ Thống</span>
      </a>
    </nav>

    <!-- AI Gemini status in sidebar -->
    <div class="p-3 border-top">
      <div class="p-2.5 rounded-3 bg-body-secondary small">
        <div class="d-flex align-items-center justify-content-between mb-1">
          <span class="fw-bold text-truncate"><i class="fa-solid fa-wand-magic-sparkles text-primary me-1"></i> Gemini AI</span>
          <span class="badge badge-soft-success">Sẵn Sàng</span>
        </div>
        <div class="text-muted" style="font-size: 0.75rem;">Model: gemini-2.5-flash</div>
      </div>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="app-main">
    <!-- Top Navbar -->
    <header class="navbar navbar-expand border-bottom px-3 px-lg-4 sticky-top bg-body">
      <button class="btn btn-sm btn-outline-secondary d-lg-none me-2" onclick="toggleSidebar()">
        <i class="bi bi-list fs-5"></i>
      </button>

      <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0 fw-bold d-none d-sm-block"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Bảng Điều Khiển' %></h5>
      </div>

      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/listings" class="btn btn-sm btn-gradient-primary rounded-pill px-3 shadow-sm">
          <i class="bi bi-plus-circle me-1"></i> Thêm BĐS
        </a>

        <!-- Theme Toggle -->
        <button class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 36px; height: 36px;" id="themeToggleBtn" onclick="toggleTheme()" title="Chuyển chế độ sáng/tối">
          <i class="bi bi-moon-stars" id="themeIcon"></i>
        </button>
      </div>
    </header>

    <!-- Alert Banner Container -->
    <div class="container-fluid px-3 px-lg-4 pt-3">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
    </div>

    <!-- Main Page Body -->
    <main class="container-fluid px-3 px-lg-4 py-3 flex-grow-1">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="border-top py-3 px-4 text-center text-muted small mt-auto bg-body-tertiary">
      <span>FB Tool Management &copy; 2026. Công cụ quản lý BĐS & tự động hóa đăng bài thông minh tích hợp Google Gemini AI.</span>
    </footer>
  </div>

  <!-- Toast Notification Container -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="appToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Thông báo</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    function toggleSidebar() {
      const sb = document.getElementById('appSidebar');
      const bd = document.getElementById('sidebarBackdrop');
      sb.classList.toggle('show');
      bd.style.display = sb.classList.contains('show') ? 'block' : 'none';
    }

    function toggleTheme() {
      const html = document.documentElement;
      const current = html.getAttribute('data-bs-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-bs-theme', next);
      localStorage.setItem('theme', next);
      updateThemeIcon(next);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon-stars';
      }
    }

    // Initialize Theme
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-bs-theme', savedTheme);
    updateThemeIcon(savedTheme);

    function showToast(msg, isSuccess = true) {
      const toastEl = document.getElementById('appToast');
      const toastMsg = document.getElementById('toastMessage');
      if (toastEl && toastMsg) {
        toastMsg.textContent = msg;
        toastEl.className = 'toast align-items-center border-0 ' + (isSuccess ? 'text-bg-success' : 'text-bg-danger');
        const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
        toast.show();
      }
    }
  </script>
</body>
</html>
